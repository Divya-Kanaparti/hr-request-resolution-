# ========================================================
# HR Request Resolution System - Environment Configuration
# ========================================================

# Application Settings
APP_NAME="HR Request Resolution System"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="hr-resolution-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Default is zero-dependency SQLite for local run; override with PostgreSQL for Docker / production
DATABASE_URL="sqlite:///./hr_request_resolution.db"
# PostgreSQL Docker example:
# DATABASE_URL="postgresql://hr_user:hr_password@localhost:5432/hr_request_resolution"
# MySQL example:
# DATABASE_URL="mysql+pymysql://root:root@localhost:3306/hr_request_resolution_demo"
DB_HOST="localhost"
DB_PORT=5432
DB_USER="hr_user"
DB_PASSWORD="hr_password"
DB_NAME="hr_request_resolution"

# AI and RAG Settings
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
CHROMA_PERSIST_DIRECTORY="./chroma_db"
USE_MOCK_LLM_FALLBACK=True

# Business Hours & SLA Configuration (24h format)
BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=17
WORK_DAYS="0,1,2,3,4"  # 0=Monday, 4=Friday
DEFAULT_RESPONSE_HOURS=4
DEFAULT_RESOLUTION_HOURS=24
HIGH_PRIORITY_RESOLUTION_HOURS=8
URGENT_PRIORITY_RESOLUTION_HOURS=4

# Synthetic Data Generation Seed
RANDOM_SEED=20261022

